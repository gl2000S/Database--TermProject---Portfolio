<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CineTrack - Movie Detail</title>
    <style>
        body { font-family: sans-serif; background: #111; color: #eee; margin: 0; padding: 2rem; }
        a { color: #e94560; text-decoration: none; }
        nav { margin-bottom: 2rem; }
        .movie-header { display: flex; gap: 2rem; margin-bottom: 2rem; }
        .movie-header img { width: 200px; border-radius: 8px; }
        .movie-info h1 { font-size: 2rem; margin: 0 0 0.5rem; }
        .meta { color: #aaa; margin-bottom: 1rem; }
        .genre-tag { background: #e94560; border-radius: 4px; padding: 2px 8px; margin-right: 6px; font-size: 0.85rem; }
        .rating-box { font-size: 1.5rem; font-weight: bold; color: #e94560; margin: 1rem 0; }
        .section-title { font-size: 1.2rem; border-bottom: 1px solid #333; padding-bottom: 0.5rem; margin: 2rem 0 1rem; }
        .cast-grid { display: flex; flex-wrap: wrap; gap: 1rem; }
        .cast-card { width: 110px; text-align: center; font-size: 0.8rem; flex-shrink: 0; }
        .cast-card .img-circle { width: 80px; height: 80px; border-radius: 50%; overflow: hidden; margin: 0 auto; background: #333; }
        .cast-card .img-circle img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .cast-card .actor-name { margin-top: 4px; color: #eee; }
        .cast-card .char-name { color: #aaa; }
        .review-card { background: #1a1a1a; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; }
        .review-meta { color: #aaa; font-size: 0.85rem; margin-bottom: 0.5rem; }
        .error { color: #e94560; font-size: 1.2rem; }
        .review-form { background: #1a1a1a; border-radius: 8px; padding: 1.2rem; margin-bottom: 1rem; }
        .review-form label { display: block; color: #aaa; font-size: 0.85rem; margin-bottom: 4px; }
        .review-form input[type="number"],
        .review-form textarea {
            width: 100%; background: #2a2a2a; border: 1px solid #333; border-radius: 6px;
            color: #eee; padding: 8px 12px; font-size: 0.95rem; outline: none;
            transition: border-color 0.2s; box-sizing: border-box;
        }
        .review-form input[type="number"] { width: 90px; }
        .review-form input[type="number"]:focus,
        .review-form textarea:focus { border-color: #e94560; }
        .review-form textarea { resize: vertical; min-height: 80px; margin-bottom: 10px; }
        .review-form .field { margin-bottom: 12px; }
        .submit-btn {
            background: #e94560; color: #fff; border: none; border-radius: 6px;
            padding: 9px 24px; font-size: 0.95rem; font-weight: 600; cursor: pointer;
            transition: background 0.2s;
        }
        .submit-btn:hover { background: #c73652; }
        .login-prompt { color: #666; font-style: italic; padding: 8px 0; }
        .watchlist-form {
            background: #1a1a1a;
            border-radius: 8px;
            padding: 1rem;
            margin: 1rem 0;
        }
        .watchlist-form select {
            padding: 0.4rem;
            margin-right: 0.5rem;
            background: #2a2a2a;
            color: #eee;
            border: 1px solid #333;
            border-radius: 6px;
        }
        .watchlist-form button {
            background: #e94560;
            color: white;
            border: none;
            padding: 0.45rem 0.8rem;
            border-radius: 4px;
            cursor: pointer;
        }
    </style>
</head>
<body>

<nav>
    <a href="/home">← Home</a>
    {{#loggedInUsername}}
    | <a href="/watchlist">Watchlist</a>
    | <a href="/profile">My Profile</a>
    | Logged in as <strong>{{loggedInUsername}}</strong>
    {{/loggedInUsername}}
</nav>

{{#error}}<p class="error">{{error}}</p>{{/error}}

{{#movie}}
<div class="movie-header">
    {{#posterUrl}}
    <img src="{{posterUrl}}" alt="{{title}} poster"
         onerror="this.src='https://via.placeholder.com/200x300?text=No+Image'">
    {{/posterUrl}}
    <div class="movie-info">
        <h1>{{title}}</h1>
        <div class="meta">
            {{#releaseYear}}{{releaseYear}}{{/releaseYear}}
            {{#runtimeMin}} · {{runtimeMin}} min{{/runtimeMin}}
        </div>
        <div>
            {{#genres}}<span class="genre-tag">{{.}}</span>{{/genres}}
        </div>
        <div class="rating-box">
            ⭐ {{avgRatingFormatted}} / 10
            <span style="font-size:1rem; color:#aaa;">({{reviewCount}} reviews)</span>
        </div>
        {{#isLoggedIn}}
        <div class="watchlist-form">
            <form method="post" action="/watchlist/add">
                <input type="hidden" name="movieId" value="{{movieId}}">
                <label for="status"><strong>Add to Watchlist:</strong></label>
                <select name="status" id="status">
                    <option value="WANT_TO_WATCH">Want to Watch</option>
                    <option value="WATCHED">Watched</option>
                    <option value="DROPPED">Dropped</option>
                </select>
                <button type="submit">Save</button>
            </form>
        </div>
        {{/isLoggedIn}}
        {{^isLoggedIn}}
        <p><a href="/login">Log in</a> to add this movie to your watchlist.</p>
        {{/isLoggedIn}}
        {{#userMovieStatus}}
        <p style="color:#aaa; margin-top:8px;">
            Currently you have this marked as <strong>{{userMovieStatus}}</strong>.
        </p>
        {{/userMovieStatus}}
        {{^userMovieStatus}}
        {{#isLoggedIn}}
        <p style="color:#aaa; margin-top:8px;">This movie is not in your watchlist yet.</p>
        {{/isLoggedIn}}
        {{/userMovieStatus}}
        <p>{{synopsis}}</p>
    </div>
</div>
{{/movie}}

<div class="section-title">Directors</div>
{{#directors}}
<p><a href="/directors/{{directorId}}">{{name}}</a></p>
{{/directors}}
{{^directors}}<p style="color:#aaa;">No director info available.</p>{{/directors}}

<div class="section-title">Cast</div>
<div class="cast-grid">
    {{#cast}}
    <div class="cast-card">
        <a href="/actors/{{actorId}}">
            <div class="img-circle">
                <img src="{{photoUrl}}" alt="{{actorName}}"
                    onerror="this.style.display='none'">
            </div>
            <div class="actor-name">{{actorName}}</div>
            <div class="char-name">{{characterName}}</div>
        </a>
    </div>
    {{/cast}}
</div>
{{^cast}}<p style="color:#aaa;">No cast info available.</p>{{/cast}}

<div class="section-title">
    {{#existingReview}}Edit Your Review{{/existingReview}}
    {{^existingReview}}Write a Review{{/existingReview}}
</div>

{{#canReview}}
<form class="review-form" method="post" action="/movies/{{movieId}}/review">
    <div class="field">
        <label>Rating (1–10)</label>
        <input type="number" name="rating" min="1" max="10" required
               value="{{#existingReview}}{{existingReview.rating}}{{/existingReview}}">
    </div>
    <div class="field">
        <label>Review (optional)</label>
        <textarea name="body" placeholder="Share your thoughts...">{{#existingReview}}{{existingReview.body}}{{/existingReview}}</textarea>
    </div>
    <button class="submit-btn" type="submit">
        {{#existingReview}}Update Review{{/existingReview}}
        {{^existingReview}}Submit Review{{/existingReview}}
    </button>
</form>
{{/canReview}}
{{^canReview}}
<p class="login-prompt"><a href="/login">Log in</a> to write a review.</p>
{{/canReview}}

<div class="section-title">All Reviews</div>
{{#reviews}}
<div class="review-card">
    <div class="review-meta">
        <a href="/users/{{userId}}">{{username}}</a> · ⭐ {{rating}}/10
    </div>
    <p>{{body}}</p>
</div>
{{/reviews}}
{{^reviews}}<p style="color:#aaa;">No reviews yet.</p>{{/reviews}}

</body>
</html>