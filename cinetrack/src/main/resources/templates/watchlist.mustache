<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Watchlist — CineTrack</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', sans-serif; background: #111; color: #eee; min-height: 100vh; padding: 2rem; }
        a { color: #e94560; text-decoration: none; }

        nav { margin-bottom: 2rem; }

        .main { max-width: 1100px; margin: 0 auto; }

        .section-title {
            font-size: 1.3rem;
            color: #eee; /* changed to white */
            margin: 2rem 0 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #333;
        }

        .movie-card {
            background: #1a1a1a;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
            display: flex;
            gap: 1rem;
            align-items: flex-start;
        }

        .movie-card img {
            width: 90px;
            border-radius: 6px;
        }

        .movie-info h3 {
            margin-bottom: 0.75rem;
        }

        select {
            padding: 0.35rem;
            margin-right: 0.4rem;
        }

        button {
            background: #e94560;
            color: white;
            border: none;
            padding: 0.4rem 0.7rem;
            border-radius: 4px;
            cursor: pointer;
        }

        button:hover {
            background: #c73652;
        }

        .remove-button {
            margin-top: 0.5rem;
            background: #333;
        }

        .empty {
            color: #777;
            margin-bottom: 1rem;
        }
        .Watched {
            background: #1a1a1a;
            border-radius: 8px;
            padding: 1rem;
            margin: 1rem 0;
        }
        .Watched select {
            padding: 0.4rem;
            margin-right: 0.5rem;
            background: #2a2a2a;
            color: #eee;
            border: 1px solid #333;
            border-radius: 6px;
        }
    </style>
</head>
<body>

<nav>
    <a href="/home">← Home</a> |
    <a href="/search">Search</a> |
    <a href="/watchlist">Watchlist</a>

    {{#loggedInUsername}}
        | Logged in as <strong>{{loggedInUsername}}</strong>
        <form method="post" action="/logout" style="display:inline;">
            <button type="submit">Logout</button>
        </form>
    {{/loggedInUsername}}
</nav>

<div class="main">
    <h1>Your Watchlist</h1>

    <!-- WATCHED -->
    <h2 class="section-title">Watched ({{watchedCount}})</h2>
    {{#watched}}
        <div class="movie-card">
            {{#posterUrl}}<img src="{{posterUrl}}" alt="{{title}} poster">{{/posterUrl}}
            <div class="movie-info">
                <h3><a href="/movies/{{movieId}}">{{title}}</a></h3>

                <form method="post" action="/watchlist/update">
                    <input type="hidden" name="movieId" value="{{movieId}}">
                    <select name="status">
                        <option value="WATCHED">Watched</option>
                        <option value="WANT_TO_WATCH">Want to Watch</option>
                        <option value="DROPPED">Dropped</option>
                    </select>
                    <button type="submit">Update</button>
                </form>

                <form method="post" action="/watchlist/delete">
                    <input type="hidden" name="movieId" value="{{movieId}}">
                    <button class="remove-button" type="submit">Remove</button>
                </form>
            </div>
        </div>
    {{/watched}}
    {{^watched}}<p class="empty">No watched movies.</p>{{/watched}}

    <!-- WANT TO WATCH -->
    <h2 class="section-title">Want to Watch ({{wantToWatchCount}})</h2>
    {{#wantToWatch}}
        <div class="movie-card">
            {{#posterUrl}}<img src="{{posterUrl}}" alt="{{title}} poster">{{/posterUrl}}
            <div class="movie-info">
                <h3><a href="/movies/{{movieId}}">{{title}}</a></h3>

                <form method="post" action="/watchlist/update">
                    <input type="hidden" name="movieId" value="{{movieId}}">
                    <select name="status">
                        <option value="WATCHED">Watched</option>
                        <option value="WANT_TO_WATCH">Want to Watch</option>
                        <option value="DROPPED">Dropped</option>
                    </select>
                    <button type="submit">Update</button>
                </form>

                <form method="post" action="/watchlist/delete">
                    <input type="hidden" name="movieId" value="{{movieId}}">
                    <button class="remove-button" type="submit">Remove</button>
                </form>
            </div>
        </div>
    {{/wantToWatch}}
    {{^wantToWatch}}<p class="empty">No movies to watch.</p>{{/wantToWatch}}

    <!-- DROPPED -->
    <h2 class="section-title">Dropped ({{droppedCount}})</h2>
    {{#dropped}}
        <div class="movie-card">
            {{#posterUrl}}<img src="{{posterUrl}}" alt="{{title}} poster">{{/posterUrl}}
            <div class="movie-info">
                <h3><a href="/movies/{{movieId}}">{{title}}</a></h3>

                <form method="post" action="/watchlist/update">
                    <input type="hidden" name="movieId" value="{{movieId}}">
                    <select name="status">
                        <option value="WATCHED">Watched</option>
                        <option value="WANT_TO_WATCH">Want to Watch</option>
                        <option value="DROPPED">Dropped</option>
                    </select>
                    <button type="submit">Update</button>
                </form>

                <form method="post" action="/watchlist/delete">
                    <input type="hidden" name="movieId" value="{{movieId}}">
                    <button class="remove-button" type="submit">Remove</button>
                </form>
            </div>
        </div>
    {{/dropped}}
    {{^dropped}}<p class="empty">No dropped movies.</p>{{/dropped}}

</div>

</body>
</html>